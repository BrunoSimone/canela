# Frontend variables. Copy this file to .env.local for development.
# NEXT_PUBLIC_* vars are exposed to the browser.

# --- Site ---
# Public site URL (canonical, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only flag. 1 pauses the public storefront and checkout APIs; 0 opens it.
# Admin authentication and provider callbacks remain available. Redeploy Vercel
# after changing this value. This flag does not enable payments.
SITE_MAINTENANCE_MODE=0

# --- Sanity (product CMS) ---
# Public dataset selectors. Omit to use production. For isolated acceptance,
# set the storefront catalog to inventory_test. Vercel Production rejects it.
NEXT_PUBLIC_SANITY_DATASET=production
# Optional exact hostname of a trusted development tunnel (no protocol or path).
CANELA_DEV_HOST=
# Studio has its own setting; the hosted client Studio stays on production.
SANITY_STUDIO_DATASET=production

# Shared secret for on-demand revalidation. A Sanity webhook calls
# /api/revalidate with this secret whenever content is published, so the site
# refreshes in seconds instead of waiting for time-based ISR. Use a long random
# string; set the SAME value here (Vercel env) and in the Sanity webhook URL.
SANITY_REVALIDATE_SECRET=

# --- PostgreSQL ---
# Use the pooled Neon connection string for application traffic in Vercel.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Use the direct Neon connection string only for migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Integration tests only. Never point this variable at production.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:55432/canela_test

# --- Mercado Pago (test application) ---
# Copy only the token shown under Tests > Test credentials.
MP_TEST_ACCESS_TOKEN=APP_USR-replace-test-token
# Webhook values are server-side. Seller ID and application ID must match the
# authoritative GET /v1/orders/{id} response for this test application.
MP_TEST_WEBHOOK_SECRET=
MP_TEST_SELLER_USER_ID=
MP_TEST_APPLICATION_ID=

# disabled | test | production. Keep disabled until the launch review is complete.
# PAYMENT_ENVIRONMENT also selects callback credentials while checkout is paused.
# Never point a test deployment at the production database or operational Zipnova account.
PAYMENT_ENVIRONMENT=test
COMMERCE_PRODUCTION_APPROVED=0
MP_PRODUCTION_ACCESS_TOKEN=
MP_PRODUCTION_WEBHOOK_SECRET=
MP_PRODUCTION_SELLER_USER_ID=
MP_PRODUCTION_APPLICATION_ID=
CHECKOUT_MODE=disabled
CHECKOUT_SIGNING_SECRET=
CHECKOUT_TEST_SHIPPING_CENTS=

# controlled_test preserves the isolated MP test tariff. zipnova requires real
# catalog packing profiles, classification and all configuration below.
SHIPPING_PROVIDER=controlled_test
ZIPNOVA_API_TOKEN=
ZIPNOVA_API_SECRET=
ZIPNOVA_ACCOUNT_ID=
ZIPNOVA_ORIGIN_ID=
# Explicit operator dispatch choice: carrier_dropoff or carrier_pickup.
ZIPNOVA_DISPATCH_TYPE=
# operational or sandbox. This records the mode confirmed by Zipnova; it does
# NOT activate a sandbox remotely. Ask support before using sandbox.
ZIPNOVA_ACCOUNT_MODE=
# Current commercial validation: one outer parcel, no pickup from this origin.
ZIPNOVA_MAX_PARCELS=1
# Box-level margin included in the quoted price, even across tariff bands.
SHIPPING_MARGIN_WEIGHT_PERCENT=5
SHIPPING_MARGIN_MAX_WEIGHT_GRAMS=200
SHIPPING_MARGIN_DIMENSION_CM=1
# disabled | sandbox | production. Live mode requires the separate commerce gate.
ZIPNOVA_FULFILLMENT_MODE=disabled

# --- Owner orders panel ---
# Authorized addresses, comma-separated. The sender domain must be verified in Resend.
ADMIN_ALLOWED_EMAILS=
ADMIN_EMAIL_FROM=
RESEND_API_KEY=
# Local fixture preview only; ignored in production.
ADMIN_DEMO_MODE=0

# --- Transactional order notifications ---
# disabled | test | production. In test, BOTH templates go only to TEST_TO.
ORDER_EMAIL_MODE=disabled
ORDER_EMAIL_FROM=
ORDER_EMAIL_TEST_TO=
ORDER_OWNER_EMAIL=
# Protected POST /api/internal/notifications; at least 32 random characters.
# Set the same value in the GitHub Actions repository secret. The workflow on main
# runs every 5 minutes (best effort), independently of customer traffic.
NOTIFICATION_WORKER_SECRET=

# Sanity stock authority (server only). Local/preview MUST use inventory_test.
SANITY_INVENTORY_TOKEN=
SANITY_INVENTORY_DATASET=inventory_test
