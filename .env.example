# Frontend variables. Copy this file to .env.local for development.
# NEXT_PUBLIC_* vars are exposed to the browser.

# --- Site ---
# Public site URL (canonical, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number, international format without "+" (e.g. 5491155551234).
NEXT_PUBLIC_WHATSAPP_NUMBER=5491155551234

# --- Sanity (product CMS) ---
# projectId/dataset are public and live in src/sanity/env.ts (not env vars),
# because the Studio bundle only reads SANITY_STUDIO_* variables.

# Shared secret for on-demand revalidation. A Sanity webhook calls
# /api/revalidate with this secret whenever content is published, so the site
# refreshes in seconds instead of waiting for time-based ISR. Use a long random
# string; set the SAME value here (Vercel env) and in the Sanity webhook URL.
SANITY_REVALIDATE_SECRET=

# --- PostgreSQL ---
# Use the pooled Neon connection string for application traffic in Vercel.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Use the direct Neon connection string only for migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Integration tests only. Never point this variable at production.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:55432/canela_test

# --- Mercado Pago (test application) ---
# Copy only the token shown under Tests > Test credentials.
MP_TEST_ACCESS_TOKEN=APP_USR-replace-test-token
# Webhook values are server-side. Seller ID and application ID must match the
# authoritative GET /v1/orders/{id} response for this test application.
MP_TEST_WEBHOOK_SECRET=
MP_TEST_SELLER_USER_ID=
MP_TEST_APPLICATION_ID=

# Checkout stays disabled unless explicitly set to test. Mercado Pago uses the
# APP_USR prefix for both credential kinds in this solution, so environment
# separation depends on the dedicated variable above. Production is unavailable
# until Correo Argentino provides the authoritative shipping quote.
CHECKOUT_MODE=disabled
CHECKOUT_SIGNING_SECRET=
CHECKOUT_TEST_SHIPPING_CENTS=
