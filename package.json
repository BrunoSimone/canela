{
  "name": "canela",
  "version": "0.1.0",
  "private": true,
  "description": "Ecommerce de artesanías Canela: vidrio, cerámica, espejos y cuadros.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "RUN_DB_INTEGRATION=1 vitest run --no-file-parallelism src/db/create-reserved-order.integration.test.ts src/modules/checkout/infrastructure/postgres/checkout-repository.integration.test.ts src/modules/payments/infrastructure/postgres/payment-confirmation-repository.integration.test.ts",
    "test:mp": "RUN_MP_CONTRACT=1 vitest run src/modules/payments/infrastructure/mercado-pago/client.contract.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "studio": "sanity dev",
    "studio:deploy": "sanity deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/locale-es-es": "^1.2.35",
    "@sanity/orderable-document-list": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "next": "16.2.9",
    "next-sanity": "^13.1.1",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-redux": "^9.3.0",
    "sanity": "^6.1.0",
    "shadcn": "^4.11.0",
    "styled-components": "^6.4.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
