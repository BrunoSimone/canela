{
  "name": "canela",
  "version": "0.1.0",
  "private": true,
  "description": "Ecommerce de artesan\u00edas Canela: vidrio, cer\u00e1mica, espejos y cuadros.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "email:dev": "email dev --dir src/emails --port 3004",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "RUN_DB_INTEGRATION=1 vitest run --no-file-parallelism src/db/create-reserved-order.integration.test.ts src/modules/checkout/infrastructure/postgres/checkout-repository.integration.test.ts src/modules/payments/infrastructure/postgres/payment-confirmation-repository.integration.test.ts src/modules/admin/infrastructure/admin-repositories.integration.test.ts src/modules/shipping/infrastructure/shipping.integration.test.ts src/modules/shipping/infrastructure/fulfillment.integration.test.ts src/modules/notifications/infrastructure/operations.integration.test.ts src/modules/notifications/infrastructure/purchase-flow.integration.test.ts src/modules/inventory/infrastructure/reservation-recovery.integration.test.ts src/modules/notifications/infrastructure/worker-deadline.integration.test.ts src/modules/notifications/infrastructure/manual-recovery-status.integration.test.ts src/modules/customization/infrastructure/postgres/frame-commerce.integration.test.ts src/modules/catalog/infrastructure/postgres/catalog.integration.test.ts src/modules/media/application/admin-upload.integration.test.ts",
    "test:mp": "RUN_MP_CONTRACT=1 vitest run src/modules/payments/infrastructure/mercado-pago/client.contract.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "studio": "sanity dev",
    "studio:deploy": "sanity deploy",
    "notifications:process": "tsx --env-file=.env.local scripts/process-notifications.ts",
    "commerce:preflight": "tsx --env-file=.env.local scripts/commerce-preflight.ts",
    "media:verify": "tsx --env-file=.env.local scripts/verify-media-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/s3-request-presigner": "3.1158.0",
    "@base-ui/react": "^1.9.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@sanity/image-url": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "lucide-react": "^1.63.0",
    "motion": "^12.43.0",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-easy-crop": "^6.2.4",
    "react-redux": "^9.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "@sanity/client": "8.13.0"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "sanity": "^6.20.0",
    "@sanity/locale-es-es": "^1.2.39",
    "@sanity/orderable-document-list": "^2.0.28",
    "styled-components": "^6.6.0",
    "shadcn": "^4.23.0",
    "react-email": "6.11.0"
  },
  "pnpm": {
    "overrides": {
      "@aws-sdk/core": "3.978.6",
      "js-yaml@^3.0.0": "^3.15.2",
      "smol-toml@<1.9.0": "^1.9.0",
      "undici@^7.0.0": "^7.30.1",
      "uuid@^11.0.0": "^11.1.1"
    }
  }
}
